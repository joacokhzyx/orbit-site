---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Orbit",
  description = "We believe Orbit could help data centers do the same work with less energy, and less environmental cost as a result.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-orbit-bg text-orbit-ink">
    <slot />
  </body>
</html>
