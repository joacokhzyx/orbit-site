---
// This file is the HTML shell only. Stylesheets are imported by the
// pages, not from here, because the design prototypes bring their own
// tokens and a conditional import here gets hoisted into a shared chunk
// anyway, which leaked the site fonts into all three of them.
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Set on pages that shouldn't be indexed (none today, but the escape hatch exists). */
  noindex?: boolean;
  /** Extra attributes for <html>, used by the design prototypes to scope a palette. */
  htmlClass?: string;
  htmlAttrs?: Record<string, string>;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  htmlClass = "",
  htmlAttrs = {},
} = Astro.props;

// A backslash, as chosen for the site: Orbit \ Do more with less. It is
// the character a reader already associates with a command prompt, and
// the product is a compiler.
//
// The homepage is the exception and does not use the backslash. It is the
// only page whose <title> is read by a stranger in a search result rather
// than by someone who has already navigated here, and "Orbit \ The Orbit
// Programming Language" says the word Orbit twice while the half that
// would have carried the keywords is decoration. So the homepage takes
// SITE.seoTitle whole, which leads with what Orbit is and spends the rest
// on the two facts that make someone click.
const pageTitle = title ? `${SITE.name} \\ ${title}` : SITE.seoTitle;

// A page that asks not to be indexed gets no canonical either. A
// self-referencing canonical on an error page is a request to index it,
// which is the opposite of what noindex means.
//
// The one thing this does NOT do is echo back whatever was asked for.
// Astro serves /learn and /learn/ both with a 200 — `trailingSlash:
// "ignore"` draws no redirect — so a canonical built from the request path
// would tell a crawler that two different URLs are each the real one, and
// the one that settles nothing. Every internal link on the site is written
// with the trailing slash, so that is the form a canonical names, and a
// request without it is pointed at the form with it. The canonical is the
// site's answer about which address is canonical, not a mirror of the
// question.
const canonical = noindex
  ? null
  : new URL(
      Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`,
      Astro.site ?? SITE.url,
    ).href;
const ogImage = new URL("/og.jpg", Astro.site ?? SITE.url).href;

// The alt describes this page, not the homepage. It used to be the
// headline on every page, so /learn, /foundation and /changelog all
// shipped a social image labelled "Orbit \ Do more with less."
const ogImageAlt = title ? `${SITE.name} \\ ${title}` : SITE.seoTitle;

---

<!doctype html>
<html lang="en" class={htmlClass} {...htmlAttrs}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* One declaration, not two media-scoped ones. `prefers-color-scheme`
        cannot see the toggle in the header, so a reader who chose dark on a
        light system got a light browser chrome to match a dark page. The
        value is the two paper tokens, and the script below keeps it in step
        with the class. */}
    <meta name="theme-color" content="#faf9f7" data-theme-color />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Runs before the first paint so the saved or system theme is already
        on <html>. Without this the page shows light, then snaps to dark. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var meta = document.querySelector("meta[data-theme-color]");
        // The two values of --paper, one per theme. The browser chrome is
        // the only thing outside the page that can be themed, so it is
        // written from the same two tokens rather than a third palette.
        var paper = { light: "#faf9f7", dark: "#131316" };
        var system = window.matchMedia("(prefers-color-scheme: dark)");
        var chosen = false;

        function paint() {
          if (!meta) return;
          meta.setAttribute("content", paper[root.classList.contains("dark") ? "dark" : "light"]);
        }

        try {
          var saved = localStorage.getItem("orbit-theme");
          chosen = saved === "light" || saved === "dark";
          root.classList.toggle("dark", chosen ? saved === "dark" : system.matches);
          /* A reader who has never chosen a theme follows the system, which
             is what the media-scoped meta used to do for them. */
          system.addEventListener("change", function (event) {
            if (!chosen) {
              root.classList.toggle("dark", event.matches);
            }
          });
        } catch (error) {
          /* Storage can be unavailable. The light default stands. */
        }

        paint();
        /* The toggle only changes the class on <html>, so that class is what
           the meta has to watch. */
        new MutationObserver(paint).observe(root, {
          attributes: true,
          attributeFilter: ["class"],
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-paper text-ink">
    {/* Still the first focusable node on the page, and still off screen
        until a keyboard asks for it. When it does appear it is a pill on
        the ink, the one treatment that has to be findable over anything it
        lands on. */}
    <a
      href="#main"
      class="sr-only rounded-[var(--radius-pill)] bg-ink px-4 py-2 text-small font-normal text-paper focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60]"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
