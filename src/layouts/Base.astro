---
// This file is the HTML shell only. Stylesheets are imported by the
// pages, not from here, because the design prototypes bring their own
// tokens and a conditional import here gets hoisted into a shared chunk
// anyway, which leaked the site fonts into all three of them.
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Set on pages that shouldn't be indexed (none today, but the escape hatch exists). */
  noindex?: boolean;
  /** Extra attributes for <html>, used by the design prototypes to scope a palette. */
  htmlClass?: string;
  htmlAttrs?: Record<string, string>;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  htmlClass = "",
  htmlAttrs = {},
} = Astro.props;

// A middle dot rather than a dash. The em dash reads as a tic once it is
// in every title on the site, and the dot is what an editorial title
// page would use anyway.
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL("/og.png", Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="en" class={htmlClass} {...htmlAttrs}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0f" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Runs before the first paint so the saved or system theme is already
        on <html>. Without this the page shows light, then snaps to dark. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("orbit-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = saved || (prefersDark ? "dark" : "light");
          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch (error) {
          /* Storage can be unavailable. The light default stands. */
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-paper text-ink">
    <a
      href="#main"
      class="sr-only rounded-md bg-ink px-4 py-2 text-small font-medium text-paper focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60]"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
