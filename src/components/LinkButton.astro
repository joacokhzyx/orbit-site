---
// Buttons follow the CTA order in section 28 of the brand system:
// read the docs first, try Orbit second, GitHub third. Weight follows the
// same order, and every variant shares one radius and one height.
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "tertiary";
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "secondary",
  external = href.startsWith("http"),
  class: className = "",
} = Astro.props;

const base =
  "text-small inline-flex items-center justify-center gap-1.5 font-medium transition-colors";

const variants = {
  primary: "h-11 rounded-[var(--radius-pill)] bg-ink px-6 text-paper hover:bg-ink-2",
  secondary:
    "h-11 rounded-[var(--radius-pill)] border border-line-2 px-6 text-ink hover:border-ink hover:bg-surface-2",
  tertiary: "h-11 rounded-[var(--radius)] px-1 text-ink underline decoration-line-2 underline-offset-4 hover:decoration-ink",
} as const;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[base, variants[variant], className]}
>
  <slot />
  {
    external && (
      <svg
        class="h-3 w-3 opacity-55"
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4.5 2.5h5v5M9.5 2.5 4 8M7.5 9.5h-5v-5" />
      </svg>
    )
  }
</a>
