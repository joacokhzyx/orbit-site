---
import Logo from "./Logo.astro";
import { SITE, REPO, docLink } from "../data/site";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "Learn",
    links: [
      { label: "What Orbit is", href: "/learn" },
      { label: "Documentation", href: "/docs" },
      { label: "Language tour", href: docLink("TOUR.md") },
      { label: "Getting started", href: docLink("GETTING_STARTED.md") },
    ],
  },
  {
    heading: "Honest limits",
    links: [
      { label: "What 0.1 can't do", href: docLink("KNOWN_LIMITATIONS.md") },
      { label: "Project status", href: docLink("STATUS.md") },
      { label: "Roadmap", href: docLink("ROADMAP.md") },
      { label: "Frequently asked", href: docLink("FAQ.md") },
    ],
  },
  {
    heading: "Project",
    links: [
      { label: "GitHub", href: REPO.url, external: true },
      { label: "Releases", href: REPO.releases, external: true },
      { label: "Changelog", href: "/changelog" },
      { label: "Report an issue", href: REPO.issues, external: true },
    ],
  },
];
---

<footer class="rule mt-24">
  <div class="mx-auto w-full max-w-6xl px-6 py-14 sm:px-8 sm:py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(3,1fr)] lg:gap-8">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="Orbit, home">
          <Logo class="h-6 w-6 text-ink" />
          <span class="font-logo text-lead leading-none font-semibold tracking-tight">Orbit</span>
        </a>
        <p class="measure text-small mt-4 text-ink-2">
          {SITE.headline} A statically typed language for APIs and microservices, with a compiler
          written in itself.
        </p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="label">{column.heading}</h2>
            <ul class="mt-4 flex flex-col gap-1">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="text-small inline-flex min-h-9 items-center gap-1 text-ink-2 transition-colors hover:text-ink"
                  >
                    {link.label}
                    {link.external && (
                      <span class="opacity-50" aria-hidden="true">
                        ↗
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="text-micro mt-14 flex flex-col gap-2 border-t border-line pt-6 text-ink-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>MIT licensed. Orbit {year}.</p>
      <p>The repository is the source of the documentation.</p>
    </div>  </div>
</footer>
