---
// Inner pages share one header shape: an eyebrow that says where you are,
// the page's own claim, and a lead sentence. The number is optional, for
// the pages that read like a sequence.
//
// The only thing this component decides is how much air sits between the
// bar and the claim, and how wide the claim is allowed to be. The spacing
// is the section rhythm, so an inner page opens with the same breath a
// section between two others has.
interface Props {
  eyebrow: string;
  heading: string;
  lead?: string;
  class?: string;
}

const { eyebrow, heading, lead, class: className = "" } = Astro.props;
---

<header class:list={["pt-12 sm:pt-16 lg:pt-20", className]}>
  <p class="label">{eyebrow}</p>
  <h1 class="text-title mt-5 max-w-3xl text-balance font-display">{heading}</h1>
  {lead && <p class="max-w-[66ch] text-lead mt-6 text-ink">{lead}</p>}
  <slot />
</header>
