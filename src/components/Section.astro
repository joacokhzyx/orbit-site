---
// A numbered section with one hairline above it. The number is the
// identity of this direction: every section on the site is numbered in
// mono, the way a standards document numbers its clauses.
interface Props {
  id?: string;
  number?: string;
  heading?: string;
  lead?: string;
  class?: string;
}

const { id, number, heading, lead, class: className = "" } = Astro.props;
---

<section id={id} class:list={["rule scroll-mt-24 pt-12 sm:pt-14", className]}>
  {
    heading && (
      <header class="mb-8 sm:mb-10">
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
          {number && <span class="mono text-small text-ink-3">{number}</span>}
          <h2 class="text-title text-balance">{heading}</h2>
        </div>
        {lead && <p class="measure text-lead mt-4 text-ink-2">{lead}</p>}
      </header>
    )
  }
  <slot />
</section>
