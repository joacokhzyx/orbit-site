---
// Typographic defaults for long-form copy written directly in a page.
// The brand asks for 15-22 word sentences, one idea each, and no
// exclamation stacks, so the styling stays quiet enough not to fight it.
---

<div class="prose-measure text-ink [&>*+*]:mt-5">
  <slot />
</div>

<style>
  .prose-measure :global(h2) {
    font-size: var(--text-heading);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    text-wrap: balance;
  }

  .prose-measure :global(h3) {
    font-size: var(--text-subheading);
    line-height: 1.3;
    margin-top: 2rem;
    text-wrap: balance;
  }

  .prose-measure :global(p),
  .prose-measure :global(li) {
    color: var(--ink-muted);
  }

  .prose-measure :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose-measure :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    transition: text-decoration-color 150ms ease;
  }

  .prose-measure :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose-measure :global(ul),
  .prose-measure :global(ol) {
    padding-left: 1.25rem;
  }

  .prose-measure :global(ul) {
    list-style: disc;
  }

  .prose-measure :global(ol) {
    list-style: decimal;
  }

  .prose-measure :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose-measure :global(li)::marker {
    color: var(--ink-subtle);
  }

  .prose-measure :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--surface-sunken);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }

  .prose-measure :global(blockquote) {
    border-left: 2px solid var(--line-strong);
    padding-left: 1rem;
    color: var(--ink-muted);
    font-style: italic;
  }
</style>
