---
// Long-form copy written directly in a page. The brand asks for 15 to 22
// word sentences, one idea each, and no exclamation stacks, so the
// styling stays quiet enough not to fight it.
---

<div class="prose-measure text-ink [&>*+*]:mt-5">
  <slot />
</div>

<style>
  .prose-measure :global(h2) {
    font-size: var(--text-heading);
    line-height: 1.28;
    margin-top: 2.5rem;
    text-wrap: balance;
  }

  .prose-measure :global(h3) {
    font-size: var(--text-lead);
    line-height: 1.4;
    margin-top: 2rem;
    text-wrap: balance;
  }

  .prose-measure :global(p),
  .prose-measure :global(li) {
    color: var(--ink-2);
  }

  .prose-measure :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose-measure :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--line-2);
    transition: text-decoration-color 150ms ease;
  }

  .prose-measure :global(a:hover) {
    text-decoration-color: var(--link);
  }

  .prose-measure :global(ul),
  .prose-measure :global(ol) {
    padding-left: 1.25rem;
  }

  .prose-measure :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .prose-measure :global(ol) {
    list-style: decimal;
  }

  /* A list marker is a small dot, not a bullet glyph, so the page keeps
     one shape language. */
  .prose-measure :global(li) {
    position: relative;
    padding-left: 1.25rem;
  }

  .prose-measure :global(ul li)::before {
    content: "";
    position: absolute;
    top: 0.7em;
    left: 0.25rem;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background-color: var(--ink-3);
  }

  .prose-measure :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose-measure :global(ol li)::marker {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prose-measure :global(blockquote) {
    border-left: 2px solid var(--line-2);
    padding-left: 1rem;
    color: var(--ink-2);
  }
</style>
