---
// Orbit source, highlighted at build time by Shiki. Nothing reaches the
// browser except the finished markup and a few hundred bytes for the
// copy button.
import { getHighlighter } from "../lib/highlighter.mjs";
import type { ShikiTransformer } from "shiki";

interface Props {
  code: string;
  /** Shown in the header, usually the file the snippet came from. */
  label?: string;
  lang?: string;
  class?: string;
}

const { code, label, lang = "orbit", class: className = "" } = Astro.props;

const trimmed = code.replace(/^\n+|\n+$/g, "");

/** The header shows the language, but only when the label doesn't say it. */
const LANG_NAMES: Record<string, string> = {
  orbit: "Orbit",
  bash: "Shell",
  json: "JSON",
  diff: "Diff",
};
const langName = LANG_NAMES[lang] ?? lang;

const highlighter = await getHighlighter();

const html = highlighter.codeToHtml(trimmed, {
  lang,
  themes: { light: "github-light", dark: "github-dark" },
  defaultColor: false,
  transformers: [
    {
      name: "orbit-block",
      pre(node) {
        node.properties.class = `${node.properties.class ?? ""} code-surface`.trim();
        if (label) {
          node.properties["aria-label"] = label;
        }
        return node;
      },
    },
  ] satisfies ShikiTransformer[],
});
---

<figure
  class:list={[
    // No border. A background step is enough, and a radius is the only
    // shape on the page.
    "group/code relative overflow-hidden rounded-[var(--radius-lg)] bg-sunken",
    className,
  ]}
>
  {
    (label || lang !== "orbit") && (
      <figcaption class="flex items-center justify-between gap-3 bg-code-bg px-4 pt-3 pb-1">
        <span class="truncate font-mono text-micro text-ink-3">{label ?? langName}</span>
        {label && <span class="text-micro text-ink-3">{langName}</span>}
      </figcaption>
    )
  }
  <div data-code-host set:html={html} />
  <button
    type="button"
    data-copy
    data-code={trimmed}
    class="absolute top-2.5 right-2.5 rounded-[var(--radius)] bg-paper/90 px-2.5 py-1.5 text-micro text-ink-2 opacity-0 backdrop-blur transition-opacity group-hover/code:opacity-100 focus-visible:opacity-100 hover:text-ink"
    aria-label="Copy code to clipboard"
  >
    Copy
  </button>
</figure>

<script>
  const labels = { idle: "Copy", done: "Copied", failed: "Press Ctrl+C" };

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const code = button.dataset.code ?? "";
      const previous = button.textContent ?? labels.idle;
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = labels.done;
      } catch {
        button.textContent = labels.failed;
      }
      window.setTimeout(() => {
        button.textContent = previous;
      }, 2000);
    });
  }
</script>
