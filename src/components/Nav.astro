---
// No border on the header. The old one had a hairline under the bar, and
// with a rule under every section as well, the page read as a stack of
// bands. The bar now separates itself with space and a blurred paper
// background, and the active link is a background step rather than an
// underline, which is the same language the sections use.
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { NAV } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  if (href.startsWith("http")) return false;
  const clean = href.replace(/\/+$/, "") || "/";
  return clean === "/" ? path === "/" : path === clean || path.startsWith(`${clean}/`);
}

const links = NAV.map((link) => ({ ...link, current: isCurrent(link.href) }));
---

<header class="sticky top-0 z-50 bg-paper/85 backdrop-blur-md supports-[backdrop-filter]:bg-paper/70">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-6 py-4 sm:px-8">
    <a
      href="/"
      class="group -ml-2 flex items-center gap-2.5 rounded-[var(--radius)] px-2 py-1"
      aria-label="Orbit, home"
      aria-current={path === "/" ? "page" : undefined}
    >
      <Logo
        class="h-6 w-6 text-ink transition-transform duration-300 group-hover:rotate-[8deg]"
      />
      <span class="font-logo text-lead leading-none font-semibold tracking-tight text-ink">
        Orbit
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
        {
          links.map((link) =>
            link.external ? (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-small flex h-10 items-center gap-1.5 rounded-[var(--radius)] px-3 text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink"
              >
                {link.label}
                <svg
                  class="h-3 w-3 opacity-60"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M4.5 2.5h5v5M9.5 2.5 4 8M7.5 9.5h-5v-5" />
                </svg>
              </a>
            ) : (
              <a
                href={link.href}
                aria-current={link.current ? "page" : undefined}
                class:list={[
                  "text-small flex h-10 items-center rounded-[var(--radius)] px-3 transition-colors",
                  link.current ? "bg-surface-2 text-ink" : "text-ink-2 hover:bg-surface-2 hover:text-ink",
                ]}
              >
                {link.label}
              </a>
            ),
          )
        }
      </nav>

      <ThemeToggle />

      {/* A disclosure rather than a component, so nothing ships for it. */}
      <details class="group/menu relative sm:hidden">
        <summary
          class="text-small flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-[var(--radius)] text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg
            class="h-4 w-4 group-open/menu:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg
            class="hidden h-4 w-4 group-open/menu:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </summary>

        <nav
          class="absolute right-0 z-50 mt-2 w-56 overflow-hidden rounded-[var(--radius-lg)] bg-surface p-1.5 shadow-[0_8px_30px_rgb(0_0_0/0.12)]"
          aria-label="Primary, mobile"
        >
          <ul class="flex flex-col">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    aria-current={link.current ? "page" : undefined}
                    class:list={[
                      "text-small flex min-h-11 items-center justify-between rounded-[var(--radius)] px-3 py-2.5 transition-colors",
                      link.current ? "bg-surface-2 text-ink" : "text-ink-2 hover:bg-surface-2 hover:text-ink",
                    ]}
                  >
                    {link.label}
                    {link.external && (
                      <span class="text-micro text-ink-3" aria-hidden="true">
                        ↗
                      </span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
