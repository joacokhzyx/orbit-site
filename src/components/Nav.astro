---
// The bar at the top of every page. It carries no rule under it: a hairline
// here drew a line across the full width of every page for the sake of one
// boundary. Instead it lifts, with the low shadow, which is the honest signal
// for a bar that sits on top of the content: something is passing underneath.
// Without either, the opaque bar sliced the text behind it at its own edge and
// left half a line of glyphs showing, which reads as a broken render.
//
// It is opaque, because a sticky bar that blurs whatever scrolls under it
// turns the page behind it into a moving texture on the one element a reader
// meets first.
//
// The links are a background step, not an underline, so "where am I" and
// "where can I go" are answered by the same mechanism.
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Search from "./Search.astro";
import DocsSectionRail from "./DocsSectionRail.astro";
import { NAV } from "../data/site";

interface Props {
  /**
   * The element this renders as. A <header> is a banner landmark, which is
   * right on a marketing page and wrong inside Starlight: there the slot
   * already sits in Starlight's own banner, so a second one gives the
   * document two unnamed banners and one nested inside the other.
   */
  as?: "header" | "div";
  /**
   * Mount the search control. It is opt-in rather than automatic because
   * Pagefind only indexes the documentation: on a marketing page the field
   * would open, accept a query, and return nothing, which is worse than no
   * field at all. The index and the control travel together.
   */
  search?: boolean;
  /**
   * Mount the documentation section rail under the bar. It lives here, and
   * not in a Starlight component slot, so that it is inside the same sticky
   * element as the navbar and cannot scroll out from under it — a section
   * switcher you have to scroll back up to reach is not a switcher.
   */
  sections?: boolean;
}

const { as: Tag = "header", search = false, sections = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  if (href.startsWith("http")) return false;
  const clean = href.replace(/\/+$/, "") || "/";
  return clean === "/" ? path === "/" : path === clean || path.startsWith(`${clean}/`);
}

const links = NAV.map((link) => ({ ...link, current: isCurrent(link.href) }));
---

<Tag class="sticky top-0 z-50 bg-paper">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-6 py-2.5 sm:px-8 sm:py-3">
    <a
      href="/"
      class="group -ml-2 flex min-h-11 items-center gap-2.5 rounded-[var(--radius-sm)] px-2 py-1"
      aria-label="Orbit, home"
      aria-current={path === "/" ? "page" : undefined}
    >
      <Logo
        class="h-6 w-6 text-ink transition-transform duration-300 group-hover:rotate-[8deg]"
      />
      <span class="font-display text-lead leading-none font-normal tracking-tight text-ink">
        Orbit
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">        {
          links.map((link) =>
            link.external ? (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-small flex min-h-11 items-center gap-1.5 rounded-[var(--radius-sm)] px-3 text-ink transition-colors hover:bg-[var(--surface-2)]"
              >
                {link.label}
                <svg
                  class="h-3 w-3 opacity-60"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M4.5 2.5h5v5M9.5 2.5 4 8M7.5 9.5h-5v-5" />
                </svg>
              </a>
            ) : (
              <a
                href={link.href}
                aria-current={link.current ? "page" : undefined}
                class:list={[
                  "text-small flex min-h-11 items-center rounded-[var(--radius-sm)] px-3 transition-colors",
                  link.current
                    ? "bg-[var(--surface-2)] text-[var(--ink)]"
                    : "text-ink hover:bg-[var(--surface-2)] hover:text-ink",
                ]}
              >
                {link.label}
              </a>
            ),
          )
        }
      </nav>

      {search && <Search />}

      <ThemeToggle />

      {/* A disclosure rather than a component, so nothing ships for it,
          apart from the four behaviours <details> does not have: Escape
          to close, a click outside to close, closing when focus leaves,
          and focus returning to the summary. Without them the panel stayed
          open over the page while a keyboard user tabbed through links
          that were no longer visible. */}
      <details class="group/menu relative sm:hidden" data-menu>
        <summary
          class="text-small flex h-11 w-11 shrink-0 cursor-pointer list-none items-center justify-center rounded-[var(--radius)] text-ink transition-colors hover:bg-[var(--surface-2)] [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg
            class="h-4 w-4 group-open/menu:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg
            class="hidden h-4 w-4 group-open/menu:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </summary>

        {/* A lifted card, not a boxed panel: a surface, a real radius and a
            shadow. A menu that is a box reads as a page region, and the
            one thing it has to read as is a short list floating over the
            content. */}
        <nav
          class="absolute right-0 z-50 mt-2 w-56 rounded-[var(--radius-lg)] bg-[var(--surface)] p-1.5 shadow-[var(--shadow-md)]"
          aria-label="Primary, mobile"
        >
          <ul class="flex flex-col">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    aria-current={link.current ? "page" : undefined}
                    class:list={[
                      "text-small flex min-h-11 items-center justify-between rounded-[var(--radius-sm)] px-3 py-2.5 transition-colors",
                      link.current
                        ? "bg-[var(--surface-2)] text-[var(--ink)]"
                        : "text-ink hover:bg-[var(--surface-2)] hover:text-ink",
                    ]}
                  >
                    {link.label}
                    {link.external && (
                      <span class="text-micro text-[var(--ink-3)]" aria-hidden="true">
                        ↗
                      </span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>

  {sections && <DocsSectionRail />}

  {/* The bar is opaque and it sits on top of the content, so whatever line of
      text happens to be at its edge is cut in half. A rule under it made that
      cut read as an edge; without one it reads as a broken render. A short
      fade below the bar is what actually settles it, because it works on the
      content rather than on the background: the bar and the page are the same
      colour here, which is also why a shadow cannot do this job. It takes the
      cut from a slice to a fade, and it is 20px of gradient instead of a line
      drawn across every page.

      It hangs off the bottom of the whole bar, which on the documentation is
      two rows deep rather than one. That is the right edge to fade at: the
      rail scrolls out from under it as a unit, and fading one row while the
      other stays sharp would draw a line across the page in the one place
      the redesign is trying not to have one. */}
  <div
    class="pointer-events-none absolute inset-x-0 -bottom-5 h-5 bg-gradient-to-b from-paper to-transparent"
    aria-hidden="true"
  >
  </div>
</Tag>

<script>
  // <details> has no built-in dismissal. A disclosure that a keyboard user
  // can open but cannot close with Escape is a menu they are stuck inside,
  // so the three missing behaviours are added here.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-menu]")) {
    const summary = menu.querySelector<HTMLElement>("summary");
    if (!summary) continue;

    function close(): void {
      menu.open = false;
    }

    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        event.stopPropagation();
        close();
        // Focus has to go back where it came from, or it lands on the body
        // and the next Tab starts the page from the top.
        summary.focus();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) close();
    });

    // Focus leaving the panel entirely closes it, so tabbing past the last
    // item does not leave an open menu floating over unrelated content.
    menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (menu.open && next instanceof Node && !menu.contains(next)) close();
    });
  }
</script>
