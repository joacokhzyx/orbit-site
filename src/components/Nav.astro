---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { NAV } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  if (href.startsWith("http")) return false;
  const clean = href.replace(/\/+$/, "") || "/";
  return clean === "/" ? path === "/" : path === clean || path.startsWith(`${clean}/`);
}

const links = NAV.map((link) => ({ ...link, current: isCurrent(link.href) }));
---

<header
  class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md supports-[backdrop-filter]:bg-paper/70"
>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
    <a
      href="/"
      class="group -ml-1 flex items-center gap-2.5 rounded-md px-1 py-1"
      aria-label="Orbit, home"
      aria-current={path === "/" ? "page" : undefined}
    >
      <Logo class="h-7 w-7 text-ink transition-transform duration-300 group-hover:rotate-[8deg]" />
      <span class="font-logo text-[1.35rem] leading-none font-semibold tracking-tight text-ink">
        Orbit
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
        {
          links.map((link) =>
            link.external ? (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1 rounded-md px-3 py-2 text-small text-ink-muted transition-colors hover:text-ink"
              >
                {link.label}
                <svg
                  class="h-3 w-3 opacity-60"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M4.5 2.5h5v5M9.5 2.5 4 8M7.5 9.5h-5v-5" />
                </svg>
              </a>
            ) : (
              <a
                href={link.href}
                aria-current={link.current ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-2 text-small transition-colors",
                  link.current
                    ? "text-ink underline decoration-line-strong decoration-1 underline-offset-[0.35em]"
                    : "text-ink-muted hover:text-ink",
                ]}
              >
                {link.label}
              </a>
            ),
          )
        }
      </nav>

      <ThemeToggle />

      {/* The mobile menu is a disclosure, not a component: no framework
          runtime ships for it, and it works before hydration because
          there is no hydration. */}
      <details class="group/menu relative sm:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full border border-line text-ink-muted transition-colors hover:border-line-strong hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg
            class="h-4 w-4 group-open/menu:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg
            class="hidden h-4 w-4 group-open/menu:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </summary>

        <nav
          class="absolute right-0 z-50 mt-3 w-56 overflow-hidden rounded-lg border border-line bg-surface shadow-md"
          aria-label="Primary, mobile"
        >
          <ul class="flex flex-col p-1.5">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    aria-current={link.current ? "page" : undefined}
                    class:list={[
                      "flex items-center justify-between rounded-md px-3 py-2.5 text-small transition-colors",
                      link.current
                        ? "bg-accent-soft text-ink"
                        : "text-ink-muted hover:bg-sunken hover:text-ink",
                    ]}
                  >
                    {link.label}
                    {link.external && (
                      <span class="text-micro text-ink-subtle" aria-hidden="true">
                        ↗
                      </span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
