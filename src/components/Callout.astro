---
// Three kinds of aside, all of them things the brand system asks to be
// loud about: a plain note, a stated limit, and a useful tip. The system
// has no emoji and no "!" styling — the distinction is carried by the
// label and a single hairline, so nothing reads as alarm.
type Variant = "note" | "limit" | "tip" | "measuring";

interface Props {
  variant?: Variant;
  label?: string;
  class?: string;
}

const { variant = "note", label, class: className = "" } = Astro.props;

const defaults: Record<Variant, string> = {
  note: "Note",
  limit: "What this can't do yet",
  tip: "Tip",
  measuring: "Still measuring",
};

const styles: Record<Variant, { box: string; icon: string; path: string }> = {
  note: {
    box: "border-line bg-surface",
    icon: "text-ink-subtle",
    path: "M12 16v-5M12 8h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
  limit: {
    box: "border-line-strong bg-sunken",
    icon: "text-ink",
    path: "M12 9v4M12 17h.01M10.3 3.9 2.4 17.5A1.9 1.9 0 0 0 4 20.4h16a1.9 1.9 0 0 0 1.6-2.9L13.7 3.9a1.9 1.9 0 0 0-3.4 0Z",
  },
  tip: {
    box: "border-line bg-surface",
    icon: "text-accent",
    path: "M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.5.4.8 1 .9 1.6l.1.6h5.2l.1-.6c.1-.6.4-1.2.9-1.6A6 6 0 0 0 12 3Z",
  },
  measuring: {
    box: "border-transparent bg-measuring-bg",
    icon: "text-measuring",
    path: "M12 8v4l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
};

const { box, icon, path } = styles[variant];
---

<aside
  class:list={[
    "flex gap-3.5 rounded-lg border p-4 sm:p-5",
    box,
    className,
  ]}
>
  <svg
    class:list={["mt-0.5 h-5 w-5 shrink-0", icon]}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={path}></path>
  </svg>
  <div class="min-w-0 text-small [&>*+*]:mt-2">
    <p class="font-semibold text-ink">{label ?? defaults[variant]}</p>
    <div class="text-ink-muted [&_code]:rounded [&_code]:border [&_code]:border-line [&_code]:bg-sunken [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2">
      <slot />
    </div>
  </div>
</aside>
