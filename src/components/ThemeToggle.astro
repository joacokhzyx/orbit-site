---
interface Props {
  /** Shown when the reader has chosen a theme, and in the page head. */
  class?: string;
}

const { class: className = "" } = Astro.props;

/**
 * aria-pressed describes the state the button puts the page in, which is
 * the dark theme. The label says the same thing in words, so the state is
 * not carried by one mechanism only. A button with neither was telling a
 * reader in dark mode that it would switch to dark.
 */
const pressed = "false";
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius)] text-ink transition-colors hover:bg-[var(--surface-2)]",
    className,
  ]}
  aria-label="Dark theme"
  aria-pressed={pressed}
>
  <svg
    class="h-4 w-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4 1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="hidden h-4 w-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "orbit-theme";

  function labelFor(theme: "light" | "dark"): string {
    return theme === "dark" ? "Light theme" : "Dark theme";
  }

  function apply(theme: "light" | "dark"): void {
    document.documentElement.classList.toggle("dark", theme === "dark");
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.setAttribute("aria-label", labelFor(theme));
      button.setAttribute("aria-pressed", String(theme === "dark"));
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next: "light" | "dark" = document.documentElement.classList.contains("dark")
        ? "light"
        : "dark";
      apply(next);
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Private mode can refuse storage. The theme still switches for
        // this page view, which is the part the reader asked for.
      }
    });
  }

  window.addEventListener("storage", (event) => {
    if (event.key === STORAGE_KEY && (event.newValue === "light" || event.newValue === "dark")) {
      apply(event.newValue);
    }
  });

  // The class is set before first paint by the inline script in the
  // layout, which runs before this module. That script never touched the
  // buttons, so a reader who arrived in dark mode was told the button would
  // switch to dark. Syncing on load costs nothing and makes the initial
  // state match the page.
  apply(document.documentElement.classList.contains("dark") ? "dark" : "light");
</script>
