---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import "../styles/global.css";
---

<Base title="Orbit">
  <Nav />

  <main class="w-full">
    <section
      class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-8 px-5 pt-16 sm:px-8 md:grid-cols-5 md:items-start md:gap-12 md:pt-28 lg:pt-36"
    >
      <h1
        class="text-balance text-3xl font-bold leading-tight tracking-tight text-[#111111] sm:text-4xl md:col-span-3 lg:text-5xl lg:leading-[1.08]"
      >
        We believe Orbit could help data centers do the same work with less
        energy, and less environmental cost as a result.
      </h1>
      <div class="md:col-span-2 md:pt-2">
        <p class="max-w-md text-lg font-semibold leading-snug sm:text-xl">
          Data centers used about 415 TWh in 2024 — around 1.5% of global
          electricity. Demand has grown about 12% a year since 2017.
        </p>
        <p class="mt-3 text-sm font-semibold text-[#111111]/70">
          IEA Energy and AI
        </p>
      </div>
    </section>

    <section class="mt-12 w-full md:mt-20">
      <img
        src="/mission-street.jpg"
        alt=""
        aria-hidden="true"
        class="h-64 w-full object-cover sm:h-80 md:h-[540px]"
        loading="lazy"
      />
    </section>
  </main>
</Base>
