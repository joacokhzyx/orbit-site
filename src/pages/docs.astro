---
import "../styles/global.css";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Callout from "../components/Callout.astro";
import LinkButton from "../components/LinkButton.astro";
import { REPO } from "../data/site";
import { DOC_GROUPS, hrefFor } from "../data/docs";

const count = DOC_GROUPS.reduce((total, group) => total + group.entries.length, 0);
---

<Base
  title="Documentation"
  description="Start with the question you are trying to answer. Every Orbit document lives in the repository, where it cannot go quietly out of date."
>
  <Nav />

  <main id="main" class="mx-auto w-full max-w-6xl px-6 sm:px-8">
    <PageHero
      eyebrow="Documentation"
      heading="Indexed by question"
      lead={`The documentation isn't on this site. It lives in the repository, next to the code it describes, where it can't go quietly out of date. Here are the ${count} documents, grouped by what you're trying to do.`}
    >
      <div class="mt-8 flex flex-wrap gap-3">
        <LinkButton href={hrefFor("GETTING_STARTED.md")} variant="primary">Getting started</LinkButton>
        <LinkButton href={REPO.url} variant="secondary">Browse the repository</LinkButton>
      </div>
    </PageHero>

    <Callout variant="note" class="mt-12" label="Why the docs aren't mirrored">
      <p>
        Two copies of the same document is one copy too many. The moment one of them falls behind,
        readers stop trusting both. So this page is an index: it names the document that answers
        your question and links straight to it, where the tests live beside it.
      </p>
    </Callout>

    <div class="pt-12">
      {
        DOC_GROUPS.map((group) => (
          <Section heading={group.title}>
            {group.note && <p class="-mt-6 mb-6 text-small text-ink-3">{group.note}</p>}
            <ul class="grid gap-6 sm:grid-cols-2 sm:gap-x-12">
              {group.entries.map((entry) => (
                <li class="rule pt-4">
                  <a href={hrefFor(entry.doc)} class="group/entry block">
                    <p class="text-small font-semibold text-balance text-ink transition-colors group-hover/entry:text-ink-2">
                      {entry.question}
                    </p>
                    <p class="text-small mt-2 leading-relaxed text-ink-2">{entry.blurb}</p>
                    <p class="mono text-micro mt-3 text-ink-3">docs/{entry.doc}</p>
                  </a>
                </li>
              ))}
            </ul>
          </Section>
        ))
      }
    </div>

    <section class="rule mt-20 py-10">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="measure">
          <h2 class="text-heading">Can't find what you need?</h2>
          <p class="text-body mt-3 text-ink-2">
            Ask. I read every issue, and a question the docs don't answer is a gap in the docs,
            not in your understanding.
          </p>
        </div>
        <div class="flex flex-none flex-wrap gap-3">
          <LinkButton href={REPO.issues} variant="primary">Open an issue</LinkButton>
          <LinkButton href={hrefFor("FAQ.md")} variant="tertiary">Read the FAQ</LinkButton>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
