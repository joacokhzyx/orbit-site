---
import "../styles/global.css";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import Callout from "../components/Callout.astro";
import LinkButton from "../components/LinkButton.astro";
import { REPO } from "../data/site";
import { docHref } from "../data/docs";
import { CHANGELOG_RELEASES } from "../data/releases";
import { LATEST } from "../lib/releases.mjs";

const ordered = [...CHANGELOG_RELEASES].sort((a, b) => b.date.localeCompare(a.date));
const formatted = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    timeZone: "UTC",
  });
---

<Base
  title="Changelog"
  description="What changed in Orbit, newest first. Every entry comes from the git history, and the changelog in the repository is the authoritative record."
  ogDescription="What changed in Orbit, newest first. Every entry comes from the git history."
>
  <Nav />

  <main id="main" class="mx-auto w-full max-w-6xl px-6 sm:px-8">
    <PageHero
      eyebrow="Changelog"
      heading="What changed, and when"
      lead="Condensed from the git history: one line per change, grouped by what it was for. Nothing here is reconstructed from memory."
    >
      <div class="mt-8 flex flex-wrap gap-3">
        <LinkButton href={REPO.releases} variant="secondary">Releases and tags</LinkButton>
        <LinkButton href={REPO.changelog} variant="tertiary">Full changelog</LinkButton>
      </div>
    </PageHero>

    <Callout variant="note" class="mt-10 sm:mt-12" label="This page is a reading">
      <p>
        The authoritative record is <a href={docHref("CHANGELOG.md")}>docs/CHANGELOG.md</a> in the
        repository, written from the commit history. This page selects the entries worth showing to
        someone who hasn't read it, so it can be behind. If the two disagree, the repository wins.
      </p>
    </Callout>

    <ol class="mt-16 flex flex-col gap-12 sm:mt-24">
      {
        ordered.map((release) => (
          <li class="pt-8 sm:pt-12">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <h2 class="font-mono text-heading font-normal text-ink">{release.version}</h2>
              <p class="text-body text-[var(--ink-2)]">{release.period}</p>
              {release.unreleased ? (
                <span class="ml-auto inline-flex items-center rounded-[var(--radius-sm)] bg-[var(--signal-bg)] px-2 py-1 font-mono text-micro leading-normal text-[var(--signal-ink)]">
                  In progress
                </span>
              ) : release.published ? (
                <time class="text-micro ml-auto text-[var(--ink-3)]" datetime={release.date}>
                  {formatted(release.date)}
                </time>
              ) : (
                <span class="text-micro ml-auto text-[var(--ink-3)]">Not published as a release</span>
              )}
            </div>
            <ul class="mt-5 flex flex-col gap-3">
              {release.highlights.map((item) => (
                <li class="flex gap-3">
                  <span
                    class="mt-2.5 h-1.5 w-1.5 flex-none rounded-[var(--radius-pill)] bg-[var(--ink-2)]"
                    aria-hidden="true"
                  />
                  <span class="text-body max-w-[66ch] text-[var(--ink-2)]">{item}</span>
                </li>
              ))}
            </ul>
            {release.published && release.downloadCount > 0 && (
              <p class="mt-5 text-small">
                <a
                  class="link"
                  href={REPO.releases}
                >
                  {release.downloadCount} download{release.downloadCount === 1 ? "" : "s"} in this
                  release
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <section class="mt-16 pt-16 sm:mt-24 sm:pt-24">
      <h2 class="text-heading">Versioning</h2>
      <p class="max-w-[66ch] text-body mt-6 text-[var(--ink-2)]">
        <code class="code-inline">orbit --version</code> prints the version the build reports, which
        for the newest release is <code class="code-inline">orbit {LATEST.version}</code>. Services
        report the same string from <code class="code-inline">/health</code>. The rules for what
        counts as a breaking change are in
        <a class="link" href={docHref("VERSIONING.md")}>versioning and compatibility</a>.
      </p>
    </section>
  </main>

  <Footer />
</Base>
