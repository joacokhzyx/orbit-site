---
import "../styles/global.css";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import Callout from "../components/Callout.astro";
import LinkButton from "../components/LinkButton.astro";
import { REPO, docLink } from "../data/site";
import { RELEASES } from "../data/releases";

const ordered = [...RELEASES].sort((a, b) => b.date.localeCompare(a.date));
const formatted = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    timeZone: "UTC",
  });
---

<Base
  title="Changelog"
  description="What changed in Orbit, newest first. Every entry comes from the git history, and the changelog in the repository is the authoritative record."
>
  <Nav />

  <main id="main" class="mx-auto w-full max-w-6xl px-6 sm:px-8">
    <PageHero
      eyebrow="Changelog"
      heading="What changed, and when"
      lead="Condensed from the git history: one line per change, grouped by what it was for. Nothing here is reconstructed from memory."
    >
      <div class="mt-8 flex flex-wrap gap-3">
        <LinkButton href={REPO.releases} variant="secondary">Releases and tags</LinkButton>
        <LinkButton href={REPO.changelog} variant="tertiary">Full changelog</LinkButton>
      </div>
    </PageHero>

    <Callout variant="note" class="mt-12" label="This page is a reading">
      <p>
        The authoritative record is <a href={docLink("CHANGELOG.md")}>docs/CHANGELOG.md</a> in the
        repository, written from the commit history. This page selects the entries worth showing to
        someone who hasn't read it, so it can be behind. If the two disagree, the repository wins.
      </p>
    </Callout>

    <ol class="mt-14 flex flex-col gap-10 pb-4">
      {
        ordered.map((release) => (
          <li class="rule pt-5">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <h2 class="mono text-body font-semibold text-ink">{release.version}</h2>
              <p class="text-body text-ink-2">{release.period}</p>
              {release.unreleased ? (
                <span class="chip ml-auto">In progress</span>
              ) : (
                <time class="text-micro ml-auto text-ink-3" datetime={release.date}>
                  {formatted(release.date)}
                </time>
              )}
            </div>
            <ul class="mt-5 flex flex-col gap-3">
              {release.highlights.map((item) => (
                <li class="flex gap-3">
                  <span
                    class="mt-2.5 h-1 w-1 flex-none rounded-full bg-ink-3"
                    aria-hidden="true"
                  />
                  <span class="text-body max-w-prose text-ink-2">{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <section class="rule mt-16 py-10">
      <h2 class="text-heading">Versioning</h2>
      <p class="prose-measure text-body mt-4 text-ink-2">
        <code class="code-inline">orbit --version</code>
        prints <code class="code-inline"
          >orbit 0.1.0</code
        >, and services still report
        <code class="code-inline">0.1.0-rc.2</code> in
        <code class="code-inline">/health</code>. The rules
        for what counts as a breaking change are in
        <a class="link" href={docLink("VERSIONING.md")}>versioning and compatibility</a>.
      </p>
    </section>
  </main>

  <Footer />
</Base>
