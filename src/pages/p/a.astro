---
// A. INFORME
// A standards document with a personality: a mono number against every
// section heading, mono for every piece of metadata, and exactly one
// hairline per section. Nothing is boxed. The amber appears once, on the
// state that needs to be noticed.
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/jetbrains-mono";
import "../../styles/proto-tokens.css";
import Base from "../../layouts/Base.astro";
import Shared from "../../components/Shared.astro";
import ProtoSwitcher from "../../components/ProtoSwitcher.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { SECTIONS } from "../../data/proto-content";
---

<Base
  title="Prototype A: Informe"
  description="Design direction A. A technical report with a numbered rail, mono metadata, and one hairline per section."
  noindex
  htmlAttrs={{ "data-proto": "a" }}
>
  <div class="flex min-h-dvh flex-col">
    <Shared nav />

    <main class="flex-1">
      <Shared hero />

      {
        SECTIONS.map((section) => (
          <section class="rule mx-auto w-full max-w-6xl px-6 sm:px-8" style="padding: 3.5rem 0">
            <header class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
              <span class="mono t-6" style="color: var(--ink-3)">
                {section.number}
              </span>
              <h2 class="t-2" style="max-width: 26ch">
                {section.heading}
              </h2>
            </header>

            {"lead" in section && section.lead && (
              <p
                class="t-5 mt-5"
                style="max-width: var(--measure); color: var(--ink-2)"
              >
                {section.lead}
              </p>
            )}

            {"items" in section && section.items && (
              <div
                class="mt-9"
                style="display: grid; gap: 2.25rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr))"
              >
                {section.items.map((item) => (
                  <div>
                    <h3 class="t-4" style="color: var(--ink)">
                      {item.title}
                    </h3>
                    <p class="t-5 mt-2" style="color: var(--ink-2)">
                      {item.body}
                    </p>
                    {"link" in item && item.link && (
                      <a
                        href={item.link.href}
                        class="t-6 mt-3 inline-block underline underline-offset-4"
                        style="color: var(--link); text-decoration-color: var(--line-2)"
                      >
                        {item.link.label}
                      </a>
                    )}
                  </div>
                ))}
              </div>
            )}

            {"paragraphs" in section && section.paragraphs && (
              <div class="mt-7 flex flex-col gap-4" style="max-width: var(--measure)">
                {section.paragraphs.map((p) => (
                  <p class="t-5" style="color: var(--ink-2)">
                    {p}
                  </p>
                ))}
              </div>
            )}

            {"chip" in section && section.chip && (
              <div class="mt-8" style="max-width: var(--measure)">
                <span class="chip">{section.chip}</span>
                <p class="t-5 mt-5" style="max-width: 52ch; color: var(--ink-2)">
                  {section.aside}
                </p>
                <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
                  {section.actions.map((action) => (
                    <a
                      href={action.href}
                      class="t-6 underline underline-offset-4"
                      style="color: var(--link); text-decoration-color: var(--line-2)"
                    >
                      {action.label}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {"footnote" in section && section.footnote && (
              <p class="t-6 mt-7" style="color: var(--ink-3)">
                {section.footnote}
              </p>
            )}

            {"code" in section && section.code && (
              <div class="mt-8">
                <CodeBlock code={section.code} label="shell" lang="bash" />
              </div>
            )}

            {"link" in section && section.link && (
              <a
                href={section.link.href}
                class="t-6 mt-7 inline-block underline underline-offset-4"
                style="color: var(--link); text-decoration-color: var(--line-2)"
              >
                {section.link.label}
              </a>
            )}
          </section>
        ))
      }
    </main>

    <Shared footer />
  </div>

  <ProtoSwitcher current="a" />
</Base>
