---
// The comparison page. Its only job is to make choosing cheap: the three
// directions side by side, what each one commits to, and what it costs.
import "../../styles/proto-tokens.css";
import Base from "../../layouts/Base.astro";

const directions = [
  {
    id: "a",
    name: "Informe",
    claim: "A standards document with a personality.",
    commits: [
      "Space Grotesk for the display, IBM Plex Sans for the body, JetBrains Mono for every label",
      "Nine greys and no accent. The only colour on the page is the amber that marks a state",
      "A link is ink with an underline. The underline is the affordance",
      "One hairline per section, nothing boxed, no radius beyond 2px",
    ],
    costs: "Austere. The warm cream of the current site goes away, and it can read cold.",
  },
  {
    id: "b",
    name: "Manuscrito",
    claim: "A magazine set properly.",
    commits: [
      "Newsreader carries the headlines and the body, so the site has a voice Inter never had",
      "Narrow measure, open leading, the section number hanging in the outer margin",
      "Oxblood is the only colour, and only for links",
      "Notices are margin notes with a short rule. No boxes anywhere",
    ],
    costs:
      "Can read as a publication rather than a tool, and a serif at small sizes costs a little legibility.",
  },
  {
    id: "c",
    name: "Manual",
    claim: "The manual, dark by default.",
    commits: [
      "JetBrains Mono for the display voice, a sans for the body",
      "A permanent navigation column and an on this page list, which is the information fix",
      "One desaturated aqua carries focus, links, and the active item",
      "The focus ring is the loudest thing on the screen, on purpose",
    ],
    costs:
      "The mono voice is the least comfortable to read at length, and it leans on the docs template look.",
  },
];

const contract = [
  "Seven type sizes. Nothing exists outside the scale, which is what removes the old 0.7em and 80% steps.",
  "Three weights: 400, 500, 600. The old build reached for 700 everywhere.",
  "One spacing rhythm on a 4px base, and one radius.",
  "A hairline divides a section. It never encloses a box.",
  "Every text pair clears 4.5:1, measured by scripts/check-contrast.mjs, which fails the build if one does not.",
  "Focus is 2px with a 2px offset, and clears 3:1 against whatever it sits on.",
  "Touch targets are at least 44px tall.",
  "No em dash in the copy. Periods, commas, colons, parentheses.",
  "Headlines run 3 to 6 words and never use a template construction.",
  "JavaScript is the theme, the menu, and the copy button. No islands.",
];
---

<Base
  title="Design prototypes"
  description="Three directions for the Orbit site. Same content, different voice, palette, and structure."
  noindex
  htmlAttrs={{ "data-proto": "a" }}
>
  <div class="bg-paper">
    <header class="rule mx-auto w-full max-w-5xl px-6 py-14 sm:px-8 sm:py-20">
      <p class="label">Design review</p>
      <h1 class="t-1 mt-5" style="max-width: 20ch">Three directions, one content set.</h1>
      <p class="t-4 mt-6" style="max-width: 58ch; color: var(--ink-2)">
        The three pages below render the same copy, so the only variable is the design. Open one,
        use the switcher in the corner to move between them, and decide on voice, colour, and
        structure.
      </p>
    </header>

    <main class="mx-auto w-full max-w-5xl px-6 pb-20 sm:px-8">
      <div class="rule" style="padding-top: 2.5rem">
        <div
          style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr))"
        >
          {
            directions.map((direction) => (
              <article class="bg-surface" style="border-radius: 4px; padding: 1.5rem">
                <p class="label">{direction.id.toUpperCase()}</p>
                <h2 class="t-2 mt-3" style="max-width: 18ch">
                  {direction.name}
                </h2>
                <p class="t-5 mt-2" style="color: var(--ink-2)">
                  {direction.claim}
                </p>

                <p class="label mt-6">What it commits to</p>
                <ul class="mt-2 flex flex-col gap-2">
                  {direction.commits.map((item) => (
                    <li class="t-6 flex gap-2" style="color: var(--ink-2)">
                      <span style="color: var(--ink-3)" aria-hidden="true">
                        ·
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <p class="label mt-6">What it costs</p>
                <p class="t-6 mt-2" style="color: var(--ink-2)">
                  {direction.costs}
                </p>

                <a
                  href={`/p/${direction.id}`}
                  class="t-6 mt-6 inline-flex h-11 items-center rounded-full px-5"
                  style="background-color: var(--ink); color: var(--paper)"
                >
                  Open {direction.name}
                </a>
              </article>
            ))
          }
        </div>
      </div>

      <section class="rule" style="padding-top: 2.5rem; margin-top: 2.5rem">
        <h2 class="t-3">Shared by all three</h2>
        <p class="t-5 mt-3" style="max-width: 62ch; color: var(--ink-2)">
          These are not options. They are the contract, and a direction that broke one of them
          would be a different proposal.
        </p>
        <div
          class="mt-6"
          style="display: grid; gap: 1.5rem 2.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr))"
        >
          {
            contract.map((item) => (
              <p class="t-6 flex gap-2.5" style="color: var(--ink-2)">
                <span style="color: var(--ink-3)" aria-hidden="true">
                  ▸
                </span>
                <span>{item}</span>
              </p>
            ))
          }
        </div>
      </section>

      <p class="t-6 mt-12" style="color: var(--ink-3)">
        The current site is still live during the review, so nothing is lost while you decide.
      </p>
    </main>
  </div>
</Base>
