---
// C. MANUAL
// A permanent navigation column and an on this page list, which is the
// information fix as much as the visual one: the site has six pages and
// thirty links into the documentation, and a top bar cannot carry that.
// Dark by default because the reader arrives to work. Mono for the
// display voice, a sans for the body, and a focus ring that is the
// loudest thing on the screen.
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/ibm-plex-sans";
import "../../styles/proto-tokens.css";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import ProtoSwitcher from "../../components/ProtoSwitcher.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { HERO, SECTIONS, FOUNDER, NAV } from "../../data/proto-content";

const toc = SECTIONS.map((section) => ({
  id: `s-${section.number}`,
  label: section.heading,
}));
---

<Base
  title="Prototype C: Manual"
  description="Design direction C. A permanent navigation column, an on this page list, and a mono display voice on a dark surface."
  noindex
  htmlClass="dark"
  htmlAttrs={{ "data-proto": "c" }}
>
  <div class="grid min-h-dvh grid-cols-1 lg:grid-cols-[15rem_minmax(0,1fr)]">
    {/* NAVIGATION COLUMN. Hidden on small screens, where it collapses
        into the top bar. The border is the only one on the page. */}
    <aside
      class="hidden lg:flex lg:flex-col"
      style="border-right: 1px solid var(--line); padding: 1.5rem 1.25rem; position: sticky; top: 0; height: 100dvh; overflow-y: auto"
    >
      <a href="/p" class="flex items-center gap-2.5" aria-label="Orbit, home">
        <Logo class="h-6 w-6" />
        <span class="display-face t-4">Orbit</span>
      </a>
      <p class="label mt-1" style="font-size: 0.6875rem">v0.1.0</p>

      <nav aria-label="Sections" class="mt-8 flex flex-col gap-0.5">
          {
            toc.map((item, i) => (
              <a
                href={`#${item.id}`}
                class="mono flex items-center gap-2.5 rounded-md px-2 py-2 transition-colors"
                style={`font-size: 0.8125rem; ${
                  i === 0
                    ? "background-color: var(--surface-2); color: var(--ink);"
                    : "color: var(--ink-2);"
                }`}
              >
                <span style="color: var(--ink-3)">{item.id.replace("s-", "")}</span>
                <span class="truncate">{item.label}</span>
              </a>
            ))
          }
      </nav>

      <nav aria-label="Site" class="mt-8 flex flex-col gap-0.5">
        {
          NAV.slice(0, 4).map((item) => (
            <a
              href={item.href}
              class="t-6 rounded-md px-2 py-1.5 transition-colors"
              style="color: var(--ink-3)"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </aside>

    <div class="flex min-w-0 flex-col">
      {/* Top bar, small screens only. */}
      <header
        class="flex items-center justify-between gap-4 px-5 py-3 lg:hidden"
        style="border-bottom: 1px solid var(--line)"
      >
        <a href="/p" class="flex items-center gap-2" aria-label="Orbit, home">
          <Logo class="h-5 w-5" />
          <span class="display-face t-5">Orbit</span>
        </a>
        <nav aria-label="Primary" class="flex items-center gap-1">
          {
            NAV.slice(0, 4).map((item) => (
              <a href={item.href} class="t-6 rounded-md px-2 py-1.5" style="color: var(--ink-2)">
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <div
        class="flex min-w-0 flex-1 flex-col gap-10 px-5 py-10 sm:px-8 lg:flex-row lg:gap-12 lg:px-10 lg:py-14"
      >
        <main class="min-w-0 flex-1">
          <section>
            <p class="label">{HERO.eyebrow}</p>
            <h1 class="display-face t-1 mt-5" style="max-width: 20ch; font-weight: 700">
              {HERO.headline}
            </h1>
            <p class="t-4 mt-6" style="max-width: 58ch; color: var(--ink-2)">
              {HERO.lead}
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="/p"
                class="t-6 inline-flex h-11 items-center rounded-md px-5"
                style="background-color: var(--focus); color: var(--paper)"
              >
                {HERO.primary}
              </a>
              <a
                href="/p"
                class="t-6 inline-flex h-11 items-center rounded-md px-5 underline underline-offset-4"
                style="color: var(--link); text-decoration-color: var(--line-2)"
              >
                {HERO.secondary}
              </a>
            </div>
          </section>

          {
            SECTIONS.map((section) => (
              <section id={`s-${section.number}`} class="pt-16" style="scroll-margin-top: 2rem">
                <div
                  class="mono flex items-baseline gap-3"
                  style="border-top: 1px solid var(--line); padding-top: 1rem; color: var(--ink-3); font-size: 0.75rem"
                >
                  <span>{section.number}</span>
                  <span aria-hidden="true" style="flex: 1">
                    ──────────
                  </span>
                </div>
                <h2 class="display-face t-2 mt-4" style="max-width: 26ch; font-weight: 700">
                  {section.heading}
                </h2>

                {"lead" in section && section.lead && (
                  <p class="t-4 mt-3" style="max-width: 62ch; color: var(--ink-2)">
                    {section.lead}
                  </p>
                )}

                {"items" in section && section.items && (
                  <dl class="mt-7 flex flex-col">
                    {section.items.map((item) => (
                      <div
                        class="py-4"
                        style="border-top: 1px solid var(--line)"
                      >
                        <dt class="t-4">{item.title}</dt>
                        <dd class="t-5 mt-1" style="color: var(--ink-2)">
                          {item.body}
                        </dd>
                        {"link" in item && item.link && (
                          <dd class="mt-1">
                            <a
                              href={item.link.href}
                              class="t-6 underline underline-offset-4"
                              style="color: var(--link); text-decoration-color: var(--line-2)"
                            >
                              {item.link.label}
                            </a>
                          </dd>
                        )}
                      </div>
                    ))}
                  </dl>
                )}

                {"paragraphs" in section && section.paragraphs && (
                  <div class="mt-6 flex flex-col gap-4" style="max-width: 62ch">
                    {section.paragraphs.map((p) => (
                      <p class="t-5" style="color: var(--ink-2)">
                        {p}
                      </p>
                    ))}
                  </div>
                )}

                {"chip" in section && section.chip && (
                  <div class="mt-7" style="max-width: 62ch">
                    <span class="chip">{section.chip}</span>
                    <p class="t-5 mt-4" style="color: var(--ink-2)">
                      {section.aside}
                    </p>
                    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                      {section.actions.map((action) => (
                        <a
                          href={action.href}
                          class="t-6 underline underline-offset-4"
                          style="color: var(--link); text-decoration-color: var(--line-2)"
                        >
                          {action.label}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {"footnote" in section && section.footnote && (
                  <p class="t-6 mt-6" style="color: var(--ink-3)">
                    {section.footnote}
                  </p>
                )}

                {"code" in section && section.code && (
                  <div class="mt-6">
                    <CodeBlock
                      class="code-figure"
                      code={section.code}
                      label="shell"
                      lang="bash"
                    />
                  </div>
                )}

                {"link" in section && section.link && (
                  <a
                    href={section.link.href}
                    class="t-6 mt-6 inline-block underline underline-offset-4"
                    style="color: var(--link); text-decoration-color: var(--line-2)"
                  >
                    {section.link.label}
                  </a>
                )}
              </section>
            ))
          }
        </main>

        {/* ON THIS PAGE. The second reason this direction is not just a look. */}
        <nav
          aria-label="On this page"
          class="hidden xl:block xl:w-56 xl:shrink-0"
          style="position: sticky; top: 3.5rem; align-self: flex-start"
        >
          <p class="label">On this page</p>
          <ul class="mt-3 flex flex-col gap-2">
            {
              toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="t-6 transition-colors"
                    style="color: var(--ink-3)"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="t-6 mt-8" style="color: var(--ink-3)">{FOUNDER}</p>
        </nav>
      </div>

      <footer
        class="mt-auto"
        style="border-top: 1px solid var(--line); padding: 1.5rem 2rem"
      >
        <p class="t-6" style="color: var(--ink-3)">{FOUNDER}</p>
      </footer>
    </div>
  </div>

  <ProtoSwitcher current="c" />
</Base>
