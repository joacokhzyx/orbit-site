---
import "../styles/global.css";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import LinkButton from "../components/LinkButton.astro";
import { REPO, docLink } from "../data/site";
---

<Base
  title="Page not found"
  description="That page isn't on this site. Nothing is broken on your side: here are the documents and pages that cover what you were probably looking for."
  noindex
>
  <Nav />

  <main id="main" class="mx-auto w-full max-w-6xl px-6 py-20 sm:px-8 sm:py-28">
    <p class="mono text-small text-ink-3">404</p>
    <h1 class="text-title mt-4 max-w-2xl text-balance font-display">That page isn't here.</h1>
    <p class="measure text-lead mt-6 text-ink-2">
      The address may be mistyped, or the page may have moved when I reorganised the
      documentation. Nothing is broken on your side.
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <LinkButton href="/" variant="primary">Go to the home page</LinkButton>
      <LinkButton href="/docs" variant="secondary">Find a document</LinkButton>
      <LinkButton href={REPO.issues} variant="tertiary">Tell me the link that broke</LinkButton>
    </div>

    <div class="rule mt-14 pt-6">
      <h2 class="label">Common starting points</h2>
      <ul class="mt-4 flex flex-col">
        <li>
          <a class="link text-small inline-flex min-h-10 items-center" href={docLink("GETTING_STARTED.md")}
            >Getting started</a
          >
        </li>
        <li>
          <a class="link text-small inline-flex min-h-10 items-center" href={docLink("TOUR.md")}
            >Language tour</a
          >
        </li>
        <li>
          <a class="link text-small inline-flex min-h-10 items-center" href={docLink("KNOWN_LIMITATIONS.md")}
            >What 0.1 can't do</a
          >
        </li>
        <li>
          <a class="link text-small inline-flex min-h-10 items-center" href={docLink("FAQ.md")}
            >Frequently asked questions</a
          >
        </li>
      </ul>
    </div>
  </main>

  <Footer />
</Base>
