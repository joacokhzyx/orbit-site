---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import LinkButton from "../components/LinkButton.astro";
import { docLink, REPO } from "../data/site";
---

<Base
  title="Page not found"
  description="That page isn't on this site. Nothing is broken on your side: here are the documents and pages that cover what you were probably looking for."
  noindex
>
  <Nav />
  <main id="main" class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <p class="font-mono text-small text-ink-subtle">404</p>
    <h1 class="mt-4 max-w-2xl text-balance text-title">That page isn't here.</h1>
    <p class="measure mt-5 text-lead text-ink-muted">
      The address may be mistyped, or the page may have moved when I reorganised the
      documentation. Nothing is broken on your side.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <LinkButton href="/" variant="primary">Go to the home page</LinkButton>
      <LinkButton href="/docs" variant="secondary">Find a document</LinkButton>
      <LinkButton href={REPO.issues} variant="tertiary">Tell me the link that broke</LinkButton>
    </div>

    <div class="mt-14 border-t border-line pt-8">
      <h2 class="text-micro font-semibold tracking-[0.08em] text-ink-subtle uppercase">
        Common starting points
      </h2>
      <ul class="mt-4 flex flex-col gap-2.5 text-small">
        <li><a class="link" href={docLink("GETTING_STARTED.md")}>Getting started</a></li>
        <li><a class="link" href={docLink("TOUR.md")}>Language tour</a></li>
        <li><a class="link" href={docLink("KNOWN_LIMITATIONS.md")}>What 0.1 can't do yet</a></li>
        <li><a class="link" href={docLink("FAQ.md")}>Frequently asked questions</a></li>
      </ul>
    </div>
  </main>
  <Footer />
</Base>
